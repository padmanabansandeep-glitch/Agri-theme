# AgriSmart Ultra Environment Configuration

# Backend API Configuration
API_PORT=8000
API_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional Supabase Integration (if not supplied, runs in verified offline / demo mode)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional LLM API Key (if provided, enables remote LLM proxy; default uses built-in verified agronomy engine)
OPENAI_API_KEY=
